<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Participant Dashboard | Uni-Run</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

    <div class="header">
        <h1>Uni-Run</h1>
        <p>Participant Dashboard</p>
    </div>

    <div class="navbar">
        <a href="index.html">Home</a>
        <a href="events.html">Browse Events</a>
        <a href="event-registration.html">Register Event</a>
        <a href="result-submission.html">Submit Result</a>
        <a href="login.html">Logout</a>
    </div>

    <div class="container">

        <div class="dashboard-grid">

            <div class="dashboard-card">
                <h3>Registered Events</h3>
                <p class="dashboard-number">2</p>
                <p>Events joined by participant</p>
            </div>

            <div class="dashboard-card">
                <h3>Completed Runs</h3>
                <p class="dashboard-number">1</p>
                <p>Completed running activities</p>
            </div>

            <div class="dashboard-card">
                <h3>Pending Results</h3>
                <p class="dashboard-number">1</p>
                <p>Result submission required</p>
            </div>

        </div>

        <div class="card">
            <h2>My Event Registrations</h2>

            <table>
                <tr>
                    <th>Event Name</th>
                    <th>Category</th>
                    <th>Distance</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>

                <tr>
                    <td>Campus Fun Run 2026</td>
                    <td>Physical Marathon</td>
                    <td>5KM</td>
                    <td>Approved</td>
                    <td><a href="result-submission.html" class="table-link">Submit Result</a></td>
                </tr>

                <tr>
                    <td>Virtual Run Challenge</td>
                    <td>Virtual Run</td>
                    <td>10KM</td>
                    <td>Pending Result</td>
                    <td><a href="result-submission.html" class="table-link">Submit Result</a></td>
                </tr>
            </table>
        </div>

        <div class="card">
            <h2>Storyboard Explanation</h2>
            <p>
                This dashboard provides a summary of participant activities such as registered events,
                completed runs, and pending result submissions.
            </p>
            <p>
                Participants can view their registered events and submit running results after completing
                a marathon or virtual run.
            </p>
        </div>

    </div>

    <div class="footer">
        <p>CSC584 Enterprise Programming | Uni-Run Storyboard</p>
    </div>

</body>
</html>