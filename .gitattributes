# Normalise line endings so the project is identical on Windows, macOS and
# Linux. Text files are stored with LF in the repository and checked out with
# whatever the local system uses.
* text=auto

# Source and markup
*.java   text
*.jsp    text
*.jspf   text
*.xml    text
*.sql    text
*.css    text
*.js     text
*.html   text
*.md     text
*.properties text

# Binary files must never be altered
*.jar    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.war    binary
